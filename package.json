{
  "name": "webmcp-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "Paste a URL. Experience the WebMCP version.",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:sandbox-worker": "esbuild proof/sandbox/workerEntry.ts --bundle --platform=node --format=esm --target=node24 --external:playwright --outfile=proof/sandbox/dist/worker.mjs",
    "sandbox:snapshot": "npm run build:sandbox-worker && node scripts/create-wrapper-sandbox-snapshot.mjs",
    "build": "npm run build:sandbox-worker && tsc -b && vite build",
    "lint": "oxlint",
    "pretest": "npm run build:sandbox-worker",
    "test": "vitest run",
    "verify:vercel-build": "npx vercel build && npm run verify:vercel-functions",
    "verify:vercel-functions": "node scripts/verify-vercel-function-artifacts.mjs",
    "verify:wrapper": "node scripts/verify-wrapper-proof.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/sandbox": "^3.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
